{
  "name": "waqti",
  "productName": "وقتي",
  "version": "1.0.0",
  "description": "وقتي — يعرف وين يروح وقتك على الكمبيوتر، يساعدك تركّز، ويوقف كل شي وقت الصلاة.",
  "main": "./out/main/index.js",
  "author": "Waqti",
  "license": "MIT",
  "private": true,
  "homepage": "https://github.com/waqti-app/waqti",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "icons": "node scripts/make-icons.mjs",
    "bench": "node scripts/bench-queries.mjs",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "adhan": "4.4.6",
    "better-sqlite3": "13.0.3",
    "get-windows": "9.3.0",
    "koffi": "3.3.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/noto-kufi-arabic": "5.3.0",
    "@playwright/test": "1.63.0",
    "@resvg/resvg-js": "2.6.2",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.2",
    "electron": "44.4.5",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.12.0",
    "lucide-react": "1.48.0",
    "motion": "13.4.4",
    "png-to-ico": "3.0.2",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-is": "19.3.0",
    "recharts": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "5.0.2"
  },
  "allowScripts": {
    "get-windows@9.3.0": true,
    "koffi@3.3.1": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
