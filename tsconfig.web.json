{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.web.tsbuildinfo"
  },
  "include": ["src/renderer/**/*", "src/shared/**/*", "src/preload/api.d.ts"],
  "exclude": ["src/shared/**/*.test.ts", "src/shared/test-setup.ts"]
}
